{
  "name": "n8n-nodes-ragas",
  "version": "0.1.0",
  "description": "n8n community node for Ragas RAG evaluation (LLM-as-judge metrics)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ragas",
    "rag",
    "rag-evaluation",
    "llm",
    "evaluation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/arturovaine/n8n-nodes-ragas",
  "author": {
    "name": "Arturo Vaine",
    "email": "arturo.vaine@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturovaine/n8n-nodes-ragas.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons && gulp build:python",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist",
    "index.js",
    "requirements.txt"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RagasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RagasEvaluate/RagasEvaluate.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
